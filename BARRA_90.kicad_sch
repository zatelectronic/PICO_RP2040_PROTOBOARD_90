	(text "1. J1 = 1x40 right-angle header on the board edge: pin n = Pico pin n (1 ... 40), left to right seen from the top."
		(exclude_from_sim no)
		(at 136.906 203.962 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "eed570e0-9a66-4189-92c9-05c65fb95e14")
	)
	(text "2. The board stands vertical on the breadboard: each pin uses its own breadboard row (40 rows, 101.6 mm)."
		(exclude_from_sim no)
		(at 136.906 206.756 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "512f711e-7bf7-4dd0-90f3-d9438301dce8")
	)
	(text "3. GND on pins 3, 8, 13, 18, 23, 28, 33 (AGND) and 38. No protection: 3.3 V logic straight from the RP2040."
		(exclude_from_sim no)
		(at 136.906 209.55 0)
		(effects
