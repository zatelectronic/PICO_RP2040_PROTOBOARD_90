	)
	(text "1. U1 = Raspberry Pi Pico (RP2040) standard, plugged into two 1x20 female headers (not on the board footprint)."
		(exclude_from_sim no)
		(at 111.506 202.692 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "cf026e55-5afa-4386-a450-b422bc09d424")
	)
	(text "2. Every Pico pin goes to a global label with the same name used on J1 (page 03). AGND (pin 33) tied to GND."
		(exclude_from_sim no)
		(at 111.506 205.486 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "a0671a62-d696-47db-a5ec-cdf14759fbe2")
	)
	(text "3. VBUS (USB 5 V), VSYS and 3V3 come from the Pico: PWR_FLAG on VBUS, VSYS and GND for the ERC."
		(exclude_from_sim no)
		(at 111.506 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "4d0e07d4-1385-47e1-9e22-f06e13677d9d")
	)
	(text "4. SWD debug pins (SWCLK / GND / SWDIO) are not used here: solder them directly on the Pico."
		(exclude_from_sim no)
		(at 111.506 211.074 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "2c8ad31d-5c02-45cb-ab42-c474f9563083")
	)
